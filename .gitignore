# Built by bridge/build-combined.mjs from a local checkout of the practice
# planner. It carries the head coach's diagram artwork, which is
# password-protected on his site and never goes in public/. THIS REPO IS
# PUBLIC, so the built page stays local — rebuild it, don't commit it.
bridge/combined.html
bridge/steve-plays.json
bridge/steve-book.json

# The hub is a real Next app, so it has real dependencies and a build. Neither
# belongs in git: node_modules is 570 MB and .next is regenerated by every
# build. Nothing else in this repo has dependencies at all — that is deliberate
# and unchanged; the hub is the DESK client, and the field client stays vanilla.
product/hub/node_modules/
product/hub/.next/
product/hub/next-env.d.ts
product/hub/tsconfig.tsbuildinfo
product/hub/out/

# The hub's test build. tsc output, regenerated by product/hub/test/build.mjs
# on every run — committing it would be committing a stale copy of lib/.
product/hub/test/.build/

# The root node_modules, for api/'s single dependency (pg). Vercel installs
# it from package.json; committing it would be committing 14 packages.
node_modules/
